{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/peerjs/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/index_v2.html"
    },
    {
      "source": "/v2",
      "destination": "/index_v2.html"
    },
    {
      "source": "/switcher",
      "destination": "/switcher.html"
    },
    {
      "source": "/director",
      "destination": "/director_suite.html"
    },
    {
      "source": "/guest",
      "destination": "/guest.html"
    }
  ]
}
